{
  "name": "@develiott/komp",
  "type": "module",
  "version": "0.1.1",
  "description": "Komp generates local docker compose file with your selected services to get you up and running in seconds",
  "author": "Eliott Wantz <contact@develiott.com> (https://develiott.com)",
  "license": "MIT",
  "homepage": "https://github.com/eliottwantz/komp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliottwantz/komp.git"
  },
  "bugs": {
    "url": "https://github.com/eliottwantz/komp/issues"
  },
  "bin": {
    "komp": "dist/index.js"
  },
  "keywords": [
    "docker",
    "docker-compose",
    "cli",
    "local-development"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir=dist --target=bun --minify",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "citty": "^0.2.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
